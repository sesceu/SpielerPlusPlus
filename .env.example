# SpielerPlus Credentials
SPIELERPLUS_EMAIL="your-email@example.com"
SPIELERPLUS_PASSWORD="your-secure-password"

# Timezone (defaults to Europe/Berlin)
SPIELERPLUS_TIMEZONE="Europe/Berlin"

# Team IDs and optional Shortcodes:
# Format: "TeamID:Shortcode, TeamID:Shortcode"
# Or simple IDs: "12345, 67890"
# If left empty, all teams for your account will be auto-detected!
SPIELERPLUS_TEAMS="12345:U15, 67890:U17"

# Include attendance status emoji in the calendar summary prefix:
# e.g. "[U15, 👍] Training"
SPIELERPLUS_ATTENDANCE_EMOJI=true

# Number of days into the future to query personal attendance status (default: 90)
# SPIELERPLUS_ATTENDANCE_DAYS=90

# Include user-defined absence blocks (Abwesend) in calendar (default: false)
# SPIELERPLUS_SHOW_ABSENCES=false

# Rate Limiting (seconds) to prevent polling the server too heavily
SPIELERPLUS_RATE_LIMIT_DELAY=1.5
SPIELERPLUS_RATE_LIMIT_JITTER=0.5
SPIELERPLUS_MAX_RETRIES=3

# CalDAV Server (ownCloud / Nextcloud / standard CalDAV)
# Example for ownCloud: https://your-cloud-domain.com/remote.php/dav
CALDAV_URL="https://cloud.example.com/remote.php/dav"
CALDAV_USERNAME="your-cloud-username"
CALDAV_PASSWORD="your-cloud-app-password"
CALDAV_CALENDAR="SpielerPlus"

